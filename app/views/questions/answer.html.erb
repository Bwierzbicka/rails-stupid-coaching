
<div class="message bg-light bg-gradient border-start border-2 border-primary-subtle p-3">
  <p class="question"><%= params[:question] %></p>
  <p><em>- You</em></p>
</div>

<div class="message bg-warning-subtle bg-gradient border-start border-2 border-warning-subtle p-3">
  <p class="answer fw-bold"><%= @answer %></p>
  <p><em>- Your coach</em></p>
</div>

<%= link_to "Ask a new question", ask_path, class: "my-link"%>
